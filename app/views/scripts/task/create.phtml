<div class="max-w-2xl mx-auto p-4 font-retro text-gray-900 mt-12">
    <div class="bg-pink-100 border-4 border-black p-8 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] relative">
        <a href="/Tasca-S3.03---App-TO-DO/web/task/index" class="absolute -top-6 -left-6 bg-yellow-300 border-4 border-black px-4 py-2 font-bold shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:bg-yellow-400 active:translate-y-1 active:shadow-none">
            &lt; Volver al Tablón
        </a>

        <h1 class="title-8bits text-xl font-extrabold text-center mb-8 uppercase drop-shadow-[2px_2px_0px_rgba(255,255,255,1)]"> Nueva Misión</h1>

        <form action="/Tasca-S3.03---App-TO-DO/web/task/create" method="POST" class="space-y-6">
            
            <div>
                <label class="block text-xl font-bold mb-2">Título</label>
                <input type="text" name="title" required placeholder="Ej: Derrotar al dragón..." class="w-full bg-white border-4 border-black p-3 outline-none focus:bg-pink-50 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
            </div>

            <div>
                <label class="block text-xl font-bold mb-2">Detalles </label>
                <textarea name="description" rows="4" required class="w-full bg-white border-4 border-black p-3 outline-none focus:bg-pink-50 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"></textarea>
            </div>

            <div class="grid grid-cols-2 gap-6">
                <div>
                    <label class="block text-xl font-bold mb-2">Aventurero</label>
                    <input type="text" name="user" required class="w-full bg-white border-4 border-black p-3 outline-none focus:bg-pink-50 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
                </div>
                <div>
                    <label class="block text-xl font-bold mb-2">Estado </label>
                    <select name="status" class="w-full bg-white border-4 border-black p-3 outline-none cursor-pointer focus:bg-pink-50 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
                        <option value="pending">Pendiente</option>
                        <option value="in_progress">En Ejecución</option>
                        <option value="completed">Acabada</option>
                    </select>
                </div>
            </div>
            
            <div class="grid grid-cols-2 gap-6">
                <div>
                    <label class="block text-xl font-bold mb-2">Fecha Inicio</label>
                    <input type="date" name="start_date" required class="w-full bg-white border-4 border-black p-3 outline-none cursor-pointer focus:bg-pink-50 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
                </div>
                <div>
                    <label class="block text-xl font-bold mb-2">Fecha Fin</label>
                    <input type="date" name="end_date" required class="w-full bg-white border-4 border-black p-3 outline-none cursor-pointer focus:bg-pink-50 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
                </div>
            </div>

            <div class="pt-6">
                <button type="submit" class="w-full flex items-center justify-center gap-3 bg-green-300 hover:bg-green-400 text-2xl border-4 border-black py-4 font-bold uppercase tracking-widest shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] active:translate-y-1 active:shadow-none transition-all">
                    <span class="icon-rpg icon-tick scale-125"></span>
                    Aceptar Misión
                </button>
            </div>
        </form>
    </div>
</div>